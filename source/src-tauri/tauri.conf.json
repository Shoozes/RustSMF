{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RustSMF",
  "version": "0.1.0",
  "identifier": "com.shoozes.rustsmf",
  "build": {
    "beforeDevCommand": "node frontend/scripts/start-vite-dev.mjs",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm --prefix ./frontend run build",
    "frontendDist": "../frontend/dist",
    "removeUnusedCommands": true
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.local http://localhost:5173 ws://localhost:5173; img-src 'self' asset: data: blob:; media-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; worker-src 'self' blob:; font-src 'self' data:;",
      "capabilities": ["default"]
    },
    "windows": [
      {
        "label": "main",
        "title": "RustSMF",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "active": false,
    "targets": ["nsis"],
    "icon": ["icons/icon.png"],
    "resources": {}
  }
}
