{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RustSMF",
  "version": "0.2.1",
  "identifier": "com.shoozes.rustsmf",
  "build": {
    "beforeDevCommand": "node frontend/scripts/start-vite-dev.mjs",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm --prefix ./frontend run build",
    "frontendDist": "../frontend/dist",
    "removeUnusedCommands": true
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.local http://ipc.localhost http://localhost:5173 ws://localhost:5173 blob:; img-src 'self' asset: data: blob:; media-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; worker-src 'self' blob:; font-src 'self' data:;",
      "capabilities": [
        "default"
      ]
    },
    "windows": [
      {
        "label": "main",
        "title": "RustSMF",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png"
    ],
    "resources": {
      "../../LICENSE": "licenses/LICENSE",
      "../../THIRD_PARTY_NOTICES.md": "licenses/THIRD_PARTY_NOTICES.md",
      "../../THIRD_PARTY_LICENSES.txt": "licenses/THIRD_PARTY_LICENSES.txt",
      "../../examples/rustsmf-demo.glb": "examples/rustsmf-demo.glb",
      "../frontend/src/vendor/FBXExporter-threejs.LICENSE.txt": "licenses/FBXExporter-threejs.LICENSE.txt"
    }
  }
}
