{
  "name": "rustsmf-source",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "setup": "npm --workspace frontend run setup",
    "build": "npm --workspace frontend run build",
    "dev": "npm --workspace frontend run dev",
    "tauri:dev": "npm --workspace frontend run tauri:dev",
    "tauri:build": "npm --workspace frontend run tauri:build",
    "lint": "npm --workspace frontend run lint",
    "check:lint-coverage": "npm --workspace frontend run check:lint-coverage",
    "typecheck": "npm --workspace frontend run typecheck",
    "typecheck:test": "npm --workspace frontend run typecheck:test",
    "check:production-any": "npm --workspace frontend run check:production-any",
    "check:game-ready-dependencies": "npm --workspace frontend run check:game-ready-dependencies",
    "test": "npm run test:unit",
    "test:e2e": "npm --workspace frontend run test:e2e",
    "test:e2e:list": "npm --workspace frontend run test:e2e:list",
    "test:journey": "npm --workspace frontend run test:journey",
    "test:journey:hand-wave": "npm --workspace frontend run test:journey:hand-wave",
    "test:visual-strict": "npm --workspace frontend run test:visual-strict",
    "test:visual-update": "npm --workspace frontend run test:visual-update",
    "test:unit": "npm --workspace frontend run test:unit",
    "game-ready": "npm --workspace frontend run game-ready --",
    "fit-rig": "npm --workspace frontend run fit-rig --",
    "fit-rig-preview": "npm --workspace frontend run fit-rig-preview --",
    "verify:rust": "cd src-tauri && cargo fmt --all -- --check && cargo clippy --all-targets -- -D warnings && cargo test && cargo check && cd ../pose-contact && cargo fmt --all -- --check && cargo clippy --all-targets -- -D warnings && cargo test && cargo check && cargo check --target wasm32-unknown-unknown",
    "verify": "npm run check:lint-coverage && npm run lint && npm run typecheck && npm run typecheck:test && npm run check:production-any && npm run check:game-ready-dependencies && npm --workspace frontend run build && npm --workspace frontend run check:entry-chunks && npm --workspace frontend run test:unit && npm run verify:rust",
    "desktop:smoke": "pwsh -File ../run.ps1 -Task desktop-smoke"
  },
  "engines": {
    "node": ">=22"
  }
}
