{
  "name": "rustsmf-source",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "setup": "npm --workspace frontend run setup",
    "build": "npm --workspace frontend run build",
    "dev": "npm --workspace frontend run dev",
    "tauri:dev": "npm --workspace frontend run tauri:dev",
    "tauri:build": "npm --workspace frontend run tauri:build",
    "lint": "npm --workspace frontend run lint",
    "typecheck": "npm --workspace frontend run typecheck",
    "typecheck:test": "npm --workspace frontend run typecheck:test",
    "test:e2e": "npm --workspace frontend run test:e2e",
    "test:unit": "npm --workspace frontend run test:unit",
    "verify": "npm run lint && npm run typecheck && npm run typecheck:test && npm --workspace frontend run build && npm --workspace frontend run check:entry-chunks && npm --workspace frontend run test:unit && cd src-tauri && cargo check",
    "desktop:smoke": "pwsh -File ../run.ps1 -Task desktop-smoke"
  },
  "engines": {
    "node": ">=22"
  }
}
