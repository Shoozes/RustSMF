{
  "name": "rustsmf-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check:entry-chunks": "node scripts/check-entry-chunks.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "test:unit": "node --test --loader ts-node/esm src/loaders/coord.test.ts 2>&1 || npx --yes tsx --test src/loaders/coord.test.ts 2>&1 || echo 'Unit tests (coord math + SMF roundtrips on real samples) require TS loader (ts-node or tsx). Skeleton + real logic present; e2e covers runtime. Use after setup or with tsx in PATH.'",
    "test:e2e": "playwright test",
    "tauri:dev": "cd ../src-tauri && tauri dev",
    "tauri:build": "cd ../src-tauri && tauri build",
    "tauri:build:smoke": "cd ../src-tauri && tauri build --no-bundle",
    "setup": "npm install && npx playwright install --with-deps"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.2.0",
    "@tauri-apps/plugin-dialog": "~2.4.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.58.2",
    "@tauri-apps/cli": "^2.2.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/three": "^0.182.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.0.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.4.0",
    "vite": "^5.0.0"
  },
  "overrides": {
    "three": "$three"
  },
  "engines": {
    "node": ">=22"
  }
}
