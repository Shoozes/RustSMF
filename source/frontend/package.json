{
  "name": "rustsmf-frontend",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "check:production-any": "node scripts/check-production-any.mjs",
    "check:game-ready-dependencies": "node scripts/check-game-ready-dependencies.mjs",
    "check:lint-coverage": "node scripts/check-eslint-coverage.mjs",
    "check:entry-chunks": "node scripts/check-entry-chunks.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "test:unit": "node scripts/run-unit-tests.mjs",
    "test:e2e": "playwright test",
    "test:e2e:list": "playwright test --list",
    "test:journey": "playwright test --config=playwright.journey.config.ts",
    "test:journey:hand-wave": "playwright test --config=playwright.journey.config.ts tests/journeys/hand-wave.journey.spec.ts",
    "test:visual-strict": "node scripts/run-strict-visuals.mjs",
    "test:visual-update": "node scripts/run-strict-visuals.mjs --update-snapshots",
    "game-ready": "tsx scripts/game-ready-cli.ts",
    "skeletal-export": "tsx scripts/skeletal-export-cli.ts",
    "pose-review": "tsx scripts/pose-review-cli.ts",
    "fit-rig": "tsx scripts/fit-rig-cli.ts",
    "fit-rig-preview": "tsx scripts/fit-rig-preview.ts",
    "tauri:dev": "cd ../src-tauri && tauri dev",
    "tauri:build": "cd ../src-tauri && tauri build",
    "tauri:build:smoke": "cd ../src-tauri && tauri build --no-bundle",
    "setup": "npm install && node ../../scripts/build-retarget-wasm.mjs --install-tools && npx playwright install --with-deps",
    "demo:generate": "tsx scripts/generate-preview-demo.ts",
    "predev": "node ../../scripts/build-retarget-wasm.mjs",
    "prebuild": "node ../../scripts/build-retarget-wasm.mjs",
    "pretypecheck": "node ../../scripts/build-retarget-wasm.mjs",
    "retarget:runtime-proof": "node ../../scripts/retarget-runtime-proof.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@tauri-apps/api": "^2.2.0",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@tauri-apps/cli": "^2.2.0",
    "@types/node": "^22.19.21",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/three": "^0.182.0",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.4.27",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^15.0.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.0.16"
  },
  "overrides": {
    "three": "$three"
  },
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "license": "MIT"
}
